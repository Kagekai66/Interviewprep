class Main {
    static int Rightdiagonal(int[][] matrix)
    {
        int n = matrix.length;
        int m = matrix[0].length;
        int sum =0;
        int a=0;
        for(int i=m-1;i>=0;i--){
            sum+= matrix[a][i];
            a++;
        }
        return sum;
    }
    static int LeftDiagonal(int[][] matrix){
        int n = matrix.length;
        int m = matrix[0].length;
        int Lsum=0;
        for(int i=0;i<n;i++){
            Lsum += matrix[i][i];
        }
        return Lsum;
    }
    public static void main(String[] args) {
     int arr[][] =  {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};
       int leftsum = LeftDiagonal(arr);
        int Rightsum = Rightdiagonal(arr);

       System.out.println(leftsum);
       System.out.print(Rightsum);
    }
}
